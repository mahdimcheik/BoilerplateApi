# Local development configuration — loaded by DotNetEnv at startup (Program.cs).
# Git-ignored: never commit real secrets. Copy .env.example when bootstrapping.
# Mirrored by Utilities/EnvironmentVariables.cs (single access point).

# URLs
API_BACK_URL=https://localhost:7125
API_FRONT_URL=http://localhost:4200

# JWT / auth
JWT_KEY=dev-only-super-long-insecure-key-change-me-in-production-please-1234567890
TOKEN_VALIDITY_MINUTES=30
COOKIES_VALIDITY_DAYS=7

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bontechnicien
DB_USER=postgres
DB_PASSWORD=postgres

# Google sign-in (server-side ID-token validation)
GOOGLE_CLIENT_ID=669751754324-uph51g0pekuskf7jbq136p0t1q6214ad.apps.googleusercontent.com

# Mail (SMTP). Empty SMTP_HOST => MailService logs links instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_LOGIN=
SMTP_KEY=
DO_NOT_REPLY_EMAIL=ne-pas-repondre@boilerplate.fr
NOTIFICATION_EMAIL=notification@boilerplate.fr
ADMIN_EMAIL=admin@boilerplate.fr

# Default admin seeded at startup
SUPER_ADMIN_EMAIL=super.admin@bontechnicien.fr
SUPER_ADMIN_PASSWORD=SuperPassword123!

# Object storage — SeaweedFS S3 gateway (SeaWeed/docker-compose.yml, filer -s3 on 8333).
# These keys MUST match SeaWeed/s3.json: without an -s3.config the gateway has no identities
# and rejects every signed request, which is all the AWS SDK sends.
S3_SERVICE_URL=http://localhost:8333
S3_ACCESS_KEY=dummy-key
S3_SECRET_KEY=dummy-secret
S3_BUCKET=medias
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:8333/medias
# Set to false when the gateway refuses anonymous GETs (SeaweedFS with an S3 config file,
# private R2 bucket...). Public objects then fall back to signed URLs too.
S3_PUBLIC_READ=true

# Storage — which IStorageService a request lands on when it doesn't say (Local | S3).
# Both backends stay registered either way, so old keys remain readable after a switch.
STORAGE_PROVIDER=Local
# Local backend: public files under wwwroot/<folder> (served by UseStaticFiles),
# private files under <root>/ next to the project — outside wwwroot, signed links only.
STORAGE_PUBLIC_FOLDER=uploads
STORAGE_PRIVATE_ROOT=storage
# Upload limits and allowlist. Extensions absent from Utilities/FileSignatures.cs are rejected
# even if listed here, since their bytes can't be verified.
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif,.pdf,.docx,.xlsx,.csv,.txt,.mp4
# Lifetime of the signed links handed out for private objects.
SIGNED_URL_MINUTES=15

# Background jobs (Hangfire). Tables are created automatically in HANGFIRE_SCHEMA of the same
# PostgreSQL database — no EF migration is involved.
HANGFIRE_ENABLED=true
HANGFIRE_SCHEMA=hangfire
# Set to false on instances that enqueue jobs but must not run them.
HANGFIRE_SERVER_ENABLED=true
# 0 = Hangfire default (ProcessorCount * 5).
HANGFIRE_WORKER_COUNT=0
HANGFIRE_RETENTION_DAYS=7
# Dashboard at HANGFIRE_DASHBOARD_PATH, protected by HTTP Basic (a browser can't send the
# API's bearer token). Leaving the password empty serves it in Development only.
HANGFIRE_DASHBOARD_ENABLED=true
HANGFIRE_DASHBOARD_PATH=/hangfire
HANGFIRE_DASHBOARD_USER=admin
HANGFIRE_DASHBOARD_PASSWORD=
