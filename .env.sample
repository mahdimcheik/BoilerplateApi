# Local development configuration — loaded by DotNetEnv at startup (Program.cs).
# Git-ignored: never commit real secrets. Copy .env.example when bootstrapping.
# Mirrored by Utilities/EnvironmentVariables.cs (single access point).

# URLs
API_BACK_URL=https://localhost:7125
API_FRONT_URL=http://localhost:4200

# JWT / auth
JWT_KEY=dev-only-super-long-insecure-key-change-me-in-production-please-1234567890
TOKEN_VALIDITY_MINUTES=30
COOKIES_VALIDITY_DAYS=7

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bontechnicien
DB_USER=postgres
DB_PASSWORD=postgres

# Google sign-in (server-side ID-token validation)
GOOGLE_CLIENT_ID=669751754324-uph51g0pekuskf7jbq136p0t1q6214ad.apps.googleusercontent.com

# Mail (SMTP). Empty SMTP_HOST => MailService logs links instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_LOGIN=
SMTP_KEY=
DO_NO_REPLY_MAIL=ne-pas-repondre@bontechnicien.fr

# Cloudflare R2 (S3-compatible) — portfolio image storage
CLOUDFLARE_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_S3_API_ENDPOINT=
CLOUDFLARE_BUCKET=bontechnicien
CLOUDFLARE_PUBLIC_URL=

# Default admin seeded at startup
SUPER_ADMIN_EMAIL=super.admin@bontechnicien.fr
SUPER_ADMIN_PASSWORD=SuperPassword123!

# Object storage — SeaweedFS S3 gateway (SeaWeed/docker-compose.yml, filer -s3 on 8333).
# Credentials are ignored when the filer runs without an S3 config file.
S3_SERVICE_URL=http://localhost:8333
S3_ACCESS_KEY=dummy-key
S3_SECRET_KEY=dummy-secret
S3_BUCKET=medias
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:8333/medias
